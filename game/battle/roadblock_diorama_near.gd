class_name RoadblockDioramaNear
extends Node2D

# Roadblock Trial V2: the curb, gravel, wheel ruts and dust are all located in
# battle world coordinates. This is only a visual layer: the underlying
# character, cover, ground and roadblock collision bodies remain authoritative.
# The near pass sits after combatants in World draw order, so boots and tyres
# visibly enter the same physical roadside instead of floating above it.
const WORLD_WIDTH := 2160.0
const GROUND_CONTACT_Y := 1035.0
const DUST_LIFETIME := 0.72

@onready var player: Combatant = $"../Player"
@onready var enemy: Combatant = $"../Enemy"
@onready var player_cover: DestructibleCover = $"../PlayerCover"
@onready var enemy_cover: DestructibleCover = $"../EnemyCover"

var _last_positions: Array[Vector2] = []
var _last_damage: Array[int] = []
var _dust: Array[Dictionary] = []


func _ready() -> void:
	queue_redraw()


func register_shot(world_position: Vector2) -> void:
	_add_dust(world_position + Vector2(0.0, 4.0), 0.46)


func register_impact(world_position: Vector2, strength: float = 1.0) -> void:
	# Debris generated by a road/cover hit touches the road. Mid-air collisions
	# keep their own existing impact effect instead of manufacturing ground dust.
	if world_position.y < GROUND_CONTACT_Y - 220.0:
		return
	var foot_position := Vector2(world_position.x, maxf(world_position.y, GROUND_CONTACT_Y - 25.0))
	_add_dust(foot_position, clampf(strength, 0.35, 1.25))


func _add_dust(world_position: Vector2, strength: float) -> void:
	if not visible:
		return
	# A capped transient array prevents sustained artillery shots from leaving
	# a growing number of short-lived particles on mobile devices.
	if _dust.size() >= 12:
		_dust.remove_at(0)
	_dust.append({"position": world_position, "age": 0.0, "strength": strength})
	queue_redraw()


func _process(delta: float) -> void:
	if not visible:
		return
	var needs_redraw := false
	var i := _dust.size() - 1
	while i >= 0:
		var burst: Dictionary = _dust[i]
		var age: float = float(burst["age"]) + delta
		if age > DUST_LIFETIME:
			_dust.remove_at(i)
		else:
			burst["age"] = age
			_dust[i] = burst
		needs_redraw = true
		i -= 1

	var positions: Array[Vector2] = [
		player.global_position, enemy.global_position,
		player_cover.global_position, enemy_cover.global_position,
	]
	var damage: Array[int] = [
		player_cover.get_damage_stage(), enemy_cover.get_damage_stage(),
	]
	if positions != _last_positions or damage != _last_damage:
		_last_positions = positions
		_last_damage = damage
		needs_redraw = true
	if needs_redraw:
		queue_redraw()


func _draw() -> void:
	# Near-camera shoulders: naturally broken road edge; entirely beneath the
	# play-space silhouettes and projectile corridor.
	draw_line(Vector2(0.0, 1188.0), Vector2(WORLD_WIDTH, 1188.0), Color("101a1f", 0.38), 14.0)
	draw_line(Vector2(0.0, 1252.0), Vector2(WORLD_WIDTH, 1252.0), Color("111a1c", 0.42), 39.0)
	for x in [70.0, 760.0, 1280.0, 2040.0]:
		draw_colored_polygon(
			PackedVector2Array([
				Vector2(x - 82.0, 1290.0), Vector2(x - 22.0, 1216.0),
				Vector2(x + 35.0, 1205.0), Vector2(x + 115.0, 1290.0),
			]),
			Color("202a2b", 0.70)
		)
		draw_line(Vector2(x - 17.0, 1221.0), Vector2(x + 29.0, 1214.0), Color("ab7755", 0.28), 3.0)

	_draw_boot_in_road(player.global_position, 1.0)
	_draw_boot_in_road(enemy.global_position, -1.0)
	_draw_vehicle_in_road(player_cover.global_position, player_cover.get_damage_stage())
	_draw_vehicle_in_road(enemy_cover.global_position, enemy_cover.get_damage_stage())
	_draw_impact_dust()


func _draw_boot_in_road(origin: Vector2, facing: float) -> void:
	# Low, imperfect grit overlaps boot soles, not the firing arm or target.
	var y := origin.y + 9.0
	draw_colored_polygon(
		PackedVector2Array([
			Vector2(origin.x - 40.0, y + 3.0),
			Vector2(origin.x - 21.0, y - 3.0),
			Vector2(origin.x + 9.0, y + 1.0),
			Vector2(origin.x + 35.0, y - 2.0),
			Vector2(origin.x + 43.0, y + 9.0),
			Vector2(origin.x - 42.0, y + 10.0),
		]),
		Color("262d2b", 0.83)
	)
	draw_line(
		Vector2(origin.x - 25.0, y - 1.0),
		Vector2(origin.x + 19.0, y + 1.0),
		Color("b49271", 0.37), 3.0
	)
	for offset in [-37.0, -9.0, 27.0]:
		draw_circle(Vector2(origin.x + offset, y + 8.0 + absf(offset) * 0.10), 2.4, Color("ab9170", 0.56))
	draw_line(
		Vector2(origin.x + 7.0 * facing, y + 13.0),
		Vector2(origin.x + 41.0 * facing, y + 16.0),
		Color("141d1e", 0.46), 3.0
	)


func _draw_vehicle_in_road(origin: Vector2, damage_stage: int) -> void:
	# Vehicle artwork has a 40-unit drop below the physical cover origin.
	# Wheel ruts and accumulated gravel therefore intersect that precise line,
	# rather than being a generic horizontal shadow disconnected from the car.
	var y := origin.y + 42.0
	var left := origin.x - 120.0
	var right := origin.x + 120.0
	for offset in [-97.0, 91.0]:
		draw_colored_polygon(
			PackedVector2Array([
				Vector2(origin.x + offset - 28.0, y + 1.0),
				Vector2(origin.x + offset - 24.0, y - 9.0),
				Vector2(origin.x + offset + 17.0, y - 8.0),
				Vector2(origin.x + offset + 33.0, y + 8.0),
				Vector2(origin.x + offset + 16.0, y + 14.0),
			]),
			Color("1e2829", 0.86)
		)
		draw_line(
			Vector2(origin.x + offset - 25.0, y + 11.0),
			Vector2(origin.x + offset + 25.0, y + 13.0),
			Color("b78b69", 0.41), 3.0
		)
	draw_line(Vector2(left, y + 13.0), Vector2(right, y + 16.0), Color("182329", 0.34), 5.0)
	for x in [left - 7.0, left + 27.0, right - 34.0, right + 9.0]:
		draw_circle(Vector2(x, y + 20.0), 3.5, Color("796b58", 0.52))

	if damage_stage > 0:
		# Visible scraps accumulate at the exact position of damaged cover.
		for n in range(damage_stage * 3):
			var side := -1.0 if n % 2 == 0 else 1.0
			var dx := side * (90.0 + float(n) * 13.0)
			var p := Vector2(origin.x + dx, y + 21.0 + float(n % 3) * 4.0)
			draw_line(p, p + Vector2(13.0 * side, -5.0), Color("6f6452", 0.84), 5.0)


func _draw_impact_dust() -> void:
	for burst in _dust:
		var age: float = float(burst["age"])
		var strength: float = float(burst["strength"])
		var origin: Vector2 = burst["position"]
		var progress := clampf(age / DUST_LIFETIME, 0.0, 1.0)
		var fade := 1.0 - progress
		var rise := progress * 64.0 * strength
		for i in range(5):
			var side := float(i - 2)
			var center := origin + Vector2(side * 20.0 * progress * strength, -rise * (0.55 + float(i % 3) * 0.21))
			var radius := (9.0 + float(i % 3) * 6.0) * (0.8 + progress) * strength
			draw_circle(center, radius, Color("ad8a67", fade * 0.17))
			draw_circle(center + Vector2(5.0, -3.0), radius * 0.65, Color("d6b28a", fade * 0.10))
		for i in range(4):
			var side := -1.0 if i % 2 == 0 else 1.0
			var spread := float(i + 1) * 17.0 * progress * strength
			var chip := origin + Vector2(spread * side, -14.0 - (1.0 - progress) * float(i + 1) * 12.0)
			draw_line(chip, chip + Vector2(6.0 * side, 4.0), Color("5c5144", fade * 0.74), 3.0)
